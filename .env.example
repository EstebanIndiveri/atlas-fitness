# Database
# For local development, use a local SQLite file:
# TURSO_DATABASE_URL=file:./local.db
# For production/staging with Turso, set:
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Session Secret (REQUIRED)
# Generate a secure random string for production
# Example: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-secure-random-string-in-production

# Telegram bot (Phase 6)
# Token from @BotFather. Leave empty in CI so outbound HTTP is skipped.
TELEGRAM_BOT_TOKEN=
# Optional. If set, POST /api/telegram/webhook requires header
# X-Telegram-Bot-Api-Secret-Token to match this value.
TELEGRAM_WEBHOOK_SECRET=

# Node Environment
NODE_ENV=development
