# Database — local / Box default is a SQLite file (no Turso account or token).
# Copy this file to `.env` (never commit `.env`).
#
# Smoke (no network): keep the file URL and an empty token.
# Real Turso cloud (optional): create a DB in Turso, then:
#   TURSO_DATABASE_URL=libsql://your-database.turso.io
#   TURSO_AUTH_TOKEN=<token from `turso db tokens create` or the dashboard>
#   CONFIRM_REMOTE_DB_BOOTSTRAP=1 npm run db:bootstrap:remote
#   npm run db:verify
# Switch back to smoke: TURSO_DATABASE_URL=file:./local.db and TURSO_AUTH_TOKEN=
# (empty). File DB and cloud DB are independent — data is not copied.
TURSO_DATABASE_URL=file:./local.db
# Optional. Required only for Turso cloud (`libsql://your-database.turso.io`).
# Leave empty for file DB.
TURSO_AUTH_TOKEN=

# Session cookie HMAC (REQUIRED — no public fallback)
# Generate a random value: openssl rand -hex 32
# The placeholder below is fine for localhost/Box smoke (NODE_ENV=development) only.
# Production refuses missing/weak secrets (including this placeholder).
SESSION_SECRET=local-dev-session-secret-change-me

# Cron endpoints Bearer token (REQUIRED for /api/cron/daily-tip and /api/cron/streak-nudge)
# Generate: openssl rand -hex 32
# Playwright CI injects CRON_SECRET=test-secret-for-e2e via webServer env — do not remove that.
CRON_SECRET=local-dev-cron-secret-change-me

# Telegram bot (optional — leave empty for local/Box smoke; no outbound HTTP)
# Default path = stub: curl POST /api/telegram/webhook without BotFather.
# Real bot (optional): @BotFather /newbot → paste token here → tunnel (ngrok or
# cloudflared) → setWebhook url=https://<tunnel>/api/telegram/webhook with
# secret_token=<TELEGRAM_WEBHOOK_SECRET>. Telegram then sends header
# X-Telegram-Bot-Api-Secret-Token (Atlas does not read a query-string secret).
# Token from @BotFather. Empty = skip real Telegram network.
TELEGRAM_BOT_TOKEN=
# Required in production and whenever TELEGRAM_BOT_TOKEN is set.
# If set, POST /api/telegram/webhook requires header
# X-Telegram-Bot-Api-Secret-Token to match this value (timing-safe compare).
# Generate for a real bot: openssl rand -hex 32 (A-Z a-z 0-9 _ - only).
TELEGRAM_WEBHOOK_SECRET=
# Local/Box/Jest smoke only. When true, the webhook stub may skip the secret
# header IF NODE_ENV is not production AND TELEGRAM_BOT_TOKEN is empty.
# Ignored in production. Never set this in a public beta / hosted env.
ALLOW_INSECURE_TELEGRAM_WEBHOOK=true

# Gemini (optional, server-side only — never NEXT_PUBLIC_*).
# Empty / missing / API failure → deterministic fallbacks for guided drafts.
# Next-exercise fallback follows routine order; weekly drafts use fixed day patterns.
# Cron /api/cron/daily-tip still uses the system tip pool (source=system).
# Weekly draft generation is authenticated and server-side; never expose this as NEXT_PUBLIC_*.
# Never commit a real key.
GEMINI_API_KEY=

# Node Environment
NODE_ENV=development

# One-command remote bootstrap requires explicit confirmation for that command.
# Do not persist this as 1 in hosted production environments.
CONFIRM_REMOTE_DB_BOOTSTRAP=

# QA account is enabled only by npm run db:seed:qa and is forbidden in production.
# Leave empty here; db:seed:qa sets this only for its own invocation.
SEED_QA_USER=

# Optional auth rate limits (requests per IP per 60s fixed window). Defaults below.
# AUTH_RATE_LIMIT_LOGIN_PER_MINUTE=10
# AUTH_RATE_LIMIT_REGISTER_PER_MINUTE=5

# Optional weekly Coach proposal quota per authenticated user + client IP per 60s.
# Default: 5. Hard maximum: 60.
# WEEKLY_PLAN_GENERATE_PER_MINUTE=5
