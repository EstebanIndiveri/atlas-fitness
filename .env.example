# Database — local / Box default is a SQLite file (no Turso account or token).
# Copy this file to `.env` (never commit `.env`).
TURSO_DATABASE_URL=file:./local.db
# Optional. Required only for Turso cloud (`libsql://your-database.turso.io`).
# Leave empty for file DB.
TURSO_AUTH_TOKEN=

# Session cookie HMAC (REQUIRED)
# Generate a random value: openssl rand -hex 32
# The placeholder below is fine for localhost/Box smoke only.
SESSION_SECRET=local-dev-session-secret-change-me

# Cron endpoints Bearer token (REQUIRED for /api/cron/daily-tip and /api/cron/streak-nudge)
# Generate: openssl rand -hex 32
# Playwright CI injects CRON_SECRET=test-secret-for-e2e via webServer env — do not remove that.
CRON_SECRET=local-dev-cron-secret-change-me

# Telegram bot (optional — leave empty for local/Box smoke; no outbound HTTP)
# Token from @BotFather. Empty = skip real Telegram network.
TELEGRAM_BOT_TOKEN=
# Optional. If set, POST /api/telegram/webhook requires header
# X-Telegram-Bot-Api-Secret-Token to match this value.
# Leave empty so the webhook stub / curl smoke works without that header.
TELEGRAM_WEBHOOK_SECRET=

# Node Environment
NODE_ENV=development
